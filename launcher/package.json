{
  "name": "void-client",
  "productName": "Void Client",
  "version": "1.0.0",
  "description": "Void Client – launcher Minecraft by 1nonly $",
  "author": "1nonly $",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.2.1",
    "electron-updater": "^6.3.9",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.oneonly.voidclient",
    "productName": "Void Client",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "src/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "electronLanguages": [
      "pl",
      "en-US"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "VoidClient-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Void Client",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "Void Client"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
